PORT=5000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ragdoc
DB_USER=postgres
DB_PASSWORD=postgres

# Any long random string
JWT_SECRET=change-me

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: comma-separated fallback chain (first one is tried first).
# Default: gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.1-flash-lite,gemini-2.5-flash
# For the fastest answers put a flash-lite model first:
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash

# Optional: the app turns Gemini's "thinking" down to the minimum for speed.
# Set to "default" to let models think more (slower, sometimes better quizzes).
# GEMINI_THINKING=default

# Optional: how many summary sections are written at once for long documents.
# Lower it to 1-2 if you hit "rate limit" errors on the free tier.
# SUMMARY_CONCURRENCY=4

# Optional: enables "Continue with Google" (same value as VITE_GOOGLE_CLIENT_ID)
# GOOGLE_CLIENT_ID=

# Optional: frontend origin(s) allowed by CORS, comma-separated
# CORS_ORIGIN=http://localhost:5173
